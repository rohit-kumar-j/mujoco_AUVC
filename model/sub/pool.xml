<mujoco model="sub">
    <compiler angle="radian"/>
    <option gravity='0 0 -9.806' timestep='0.001' density="1000" viscosity="0.00009" />

  <asset>
    <model name="sub_main" file="sub_multi.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.3 0.3" rgb2="1.0 1.0 1.0" width="512" height="512"/>
  </asset>


  <worldbody>
      <frame pos="0 0 0">
        <attach model="sub_main" body="sub" prefix="0_"/>
      </frame>

      <frame pos="2 1 0">
        <attach model="sub_main" body="sub" prefix="1_"/>
      </frame>

      <frame pos="1 -1 -.2" euler="0 0 0">
        <attach model="sub_main" body="sub" prefix="2_"/>
      </frame>

      <geom name="pool_right_wall" type="plane"   euler="1.57 0 1.57" pos="0 7.3125 -1.08" size="1.2 11.43 12"/>
      <geom name="pool_left_wall"  type="plane"  euler="-1.57 0 1.57" pos="0 -7.3125 -1.08" size="1.2 11.43 12"/>
      <geom name="pool_rear_wall"  type="plane"  euler="0 1.57 0" pos="-11.43 0 -0.9" size="1 7.3152  5.3152"/>
      <geom name="pool_front_wall" type="plane"  euler="0 -1.57 0" pos="11.43 0 -1.18" size="1.3 7.3152 7.3152"/>
      <geom name="pool_floor"      type="plane"  euler="0 0.0354833708 0" pos="0 0 -2.16" size="11.43 7.3152 .01"/>

  </worldbody>
  <sensor>
      <framequat name="orn_s2" objtype="site" objname="1_imu" reftype="site" refname="0_imu"/>
      <framepos name="pos_s2" objtype="site" objname="1_imu" reftype="site" refname="0_imu"/>
      <framequat name="orn_s3" objtype="site" objname="2_imu" reftype="site" refname="0_imu"/>
      <framepos name="pos_s3" objtype="site" objname="2_imu" reftype="site" refname="0_imu"/>
  </sensor>

</mujoco>

